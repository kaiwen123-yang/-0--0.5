            "action_equals_next_state"
          ],
          "rows": [
            {
              "dataset": "Ray0v0/cl-piper-single-stack-bowls",
              "sample_rows": 382,
              "checked_transitions": 381,
              "action_equals_next_state": true
            }
          ],
          "preview": {
            "kind": "sample",
            "note": "每个数据集仅 episode 0；未检查全库。"
          },
          "methods": [
            {
              "language": "python",
              "code": "state = np.asarray(values['observation.state'])\naction = np.asarray(values['action'])\nnext_match = bool(np.array_equal(action[:-1], state[1:]))"
            }
          ]
